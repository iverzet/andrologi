# Copiază în .env.local. Nu publica valorile reale în Git.
# URL PostgreSQL cu pooling, furnizat de integrarea Neon din Vercel.
DATABASE_URL=
# URL direct pentru migrații; opțional dacă DATABASE_URL permite migrații.
DIRECT_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# true activează explicit catalogul demonstrativ fără acces la baza de date.
DEMO_MODE=false
# Activează doar când rulezi seed-ul într-o bază destinată datelor de test.
ALLOW_DEMO_SEED=false
# Minimum 32 caractere aleatoare; exclusiv pe server.
ADMIN_SECRET_KEY=
ADMIN_EMAIL=contact@protologi.ro
RESEND_API_KEY=
# Adresă de expeditor pe un domeniu verificat în Resend.
EMAIL_FROM=
# Activează după înlocuirea datelor demonstrative și verificarea domeniului.
SITE_INDEXABLE=false
